# Gmail import integration
IMPORT_GMAIL_USER=me
IMPORT_GMAIL_MAX_RESULTS=500
IMPORT_LABEL_SBI=CC Transactions/SBI
IMPORT_LABEL_HDFC=CC Transactions/HDFC
IMPORT_LABEL_ICICI=CC Transactions/ICICI

# Parser debug flags
IMPORT_DEBUG_PARSER_INPUT=false
IMPORT_DEBUG_BODY_MAX_LEN=1200

# Field-level encryption for sensitive card data (fullCardNumber, CVV)
