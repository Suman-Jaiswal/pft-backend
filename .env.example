# Production runtime
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRY=24h

# Google OAuth / auth redirects
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
AUTH_SUCCESS_REDIRECT=

# Google OAuth / auth redirects for import jobs
IMPORT_GOOGLE_REDIRECT_URI=
IMPORT_GMAIL_SCOPE=
IMPORT_REAUTH_SUCCESS_REDIRECT=

# Migration/owner bootstrap helpers
MIGRATION_FIRESTORE_UID=
MIGRATION_OWNER_EMAIL=
SEED_OWNER_TENANT_ID=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_ROLE=ADMIN

# Import job controls
IMPORT_JOB_TOKEN=
IMPORT_SHADOW_MODE=true
IMPORT_ENABLED_BANKS=SBI_5965,HDFC_9335,ICICI_SHARED

# Gmail import integration
IMPORT_GMAIL_USER=me
IMPORT_GMAIL_MAX_RESULTS=500
IMPORT_LABEL_SBI=CC Transactions/SBI
IMPORT_LABEL_HDFC=CC Transactions/HDFC
IMPORT_LABEL_ICICI=CC Transactions/ICICI

# Parser debug flags
IMPORT_DEBUG_PARSER_INPUT=false
IMPORT_DEBUG_BODY_MAX_LEN=1200

# Field-level encryption for sensitive card data (fullCardNumber, CVV)
FIELD_ENCRYPTION_KEY=

# Gemini (statement + txn parsing). Model quotas are per-model + per Cloud
# Billing tier on the project owning this key - NOT affected by a personal
# Google AI Plus/Pro/Ultra subscription, that's a separate consumer product.
# gemini-2.5-flash-lite has the highest free-tier RPD/RPM ceiling of the
# 2.5 family; gemini-2.5-pro has the lowest (heavier model = tighter quota).
STATEMENT_GEMINI_API_KEY=
STATEMENT_GEMINI_MODEL=gemini-2.5-flash-lite

CORS_ORIGIN=