# Neon connection example (replace placeholders with your Neon project values)
PORT=4000
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
JWT_SECRET=jwt-secret-string
JWT_EXPIRY=24h

# Seed owner user
SEED_OWNER_TENANT_ID=tenant_default
SEED_OWNER_EMAIL=admin@pft-backend.com
SEED_OWNER_PASSWORD=qwerty123
SEED_OWNER_ROLE=ADMIN
