name: rpi-cicd

on:
  push:
    branches:
      - main
      - 'stage/**'
  workflow_dispatch:

permissions:
  contents: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
  NODE_VERSION: '20'
  ARCHIVE_NAME: pft-backend-release.tgz

jobs:
  ci:
    name: Build and test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup Node
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma client
        run: npm run prisma:generate

      - name: Lint
        run: npm run lint

      - name: Unit tests
        run: npm run test

      - name: Build
        run: npm run build

      - name: Create deployment archive
        run: |
          tar -czf "${RUNNER_TEMP}/${ARCHIVE_NAME}" \
            --exclude='.git' \
            --exclude='.github' \
            --exclude='node_modules' \
            --exclude='dist' \
            --exclude='coverage' \
            --exclude='*.log' \
            .

      - name: Upload deployment archive
        uses: actions/upload-artifact@v4
        with:
          name: backend-release
          path: ${{ runner.temp }}/${{ env.ARCHIVE_NAME }}
          if-no-files-found: error
          retention-days: 7

  migrate:
    name: Run production DB migration
    runs-on: ubuntu-latest
    needs: ci
    if: github.event_name != 'pull_request'
    env:
      MIGRATION_AUTO_RECOVER: ${{ secrets.MIGRATION_AUTO_RECOVER }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup Node
        uses: actions/setup-node@v5
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma client
        run: npm run prisma:generate

      - name: Auto-recover failed migrations (optional)
        if: ${{ env.MIGRATION_AUTO_RECOVER == 'true' }}
        env:
          DATABASE_URL: ${{ secrets.PROD_DATABASE_URL }}
        run: |
          set -euo pipefail
          echo "MIGRATION_AUTO_RECOVER enabled; attempting resolve --rolled-back for tracked migrations."
          for dir in prisma/migrations/*; do
            name="$(basename "$dir")"
            if [[ "$name" == "migration_lock.toml" ]]; then
              continue
            fi
            npx prisma migrate resolve --rolled-back "$name" || true
          done

      - name: Migrate production database
        env:
          DATABASE_URL: ${{ secrets.PROD_DATABASE_URL }}
        run: npm run prisma:migrate:deploy

  deploy:
    name: Deploy Docker container to Raspberry Pi 5
    runs-on: ubuntu-latest
    needs: [ci, migrate]
    if: github.event_name != 'pull_request'
    steps:
      - name: Download deployment archive
        uses: actions/download-artifact@v4
        with:
          name: backend-release
          path: .

      - name: Copy release archive to Pi
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.RPI_HOST }}
          username: ${{ secrets.RPI_USERNAME }}
          key: ${{ secrets.RPI_SSH_PRIVATE_KEY }}
          port: ${{ secrets.RPI_PORT || 22 }}
          source: ${{ env.ARCHIVE_NAME }}
          target: /tmp
          overwrite: true

      - name: Run remote deploy (docker build + container restart)
        uses: appleboy/ssh-action@v1.0.3
        env:
          GITHUB_SHA: ${{ github.sha }}
          RPI_APP_DIR: ${{ secrets.RPI_APP_DIR }}
          RPI_CONTAINER_NAME: ${{ secrets.RPI_CONTAINER_NAME }}
          RPI_APP_PORT: ${{ secrets.RPI_APP_PORT }}
          RPI_ENV_FILE_CONTENT: ${{ secrets.RPI_ENV_FILE_CONTENT }}
        with:
          host: ${{ secrets.RPI_HOST }}
          username: ${{ secrets.RPI_USERNAME }}
          key: ${{ secrets.RPI_SSH_PRIVATE_KEY }}
          port: ${{ secrets.RPI_PORT || 22 }}
          envs: GITHUB_SHA,RPI_APP_DIR,RPI_CONTAINER_NAME,RPI_APP_PORT,RPI_ENV_FILE_CONTENT
          script: |
            set -euo pipefail
            APP_DIR="${RPI_APP_DIR:-/opt/pft-backend}"
            CONTAINER_NAME="${RPI_CONTAINER_NAME:-pft-backend-app}"
            APP_PORT="${RPI_APP_PORT:-4000}"
            ARCHIVE="/tmp/pft-backend-release.tgz"
            BOOTSTRAP_DIR="${APP_DIR}/.bootstrap-deploy"

            rm -rf "${BOOTSTRAP_DIR}"
            mkdir -p "${BOOTSTRAP_DIR}"
            tar -xzf "${ARCHIVE}" -C "${BOOTSTRAP_DIR}"
            chmod +x "${BOOTSTRAP_DIR}/scripts/deploy-rpi.sh"

            APP_DIR="${APP_DIR}" \
            RPI_CONTAINER_NAME="${CONTAINER_NAME}" \
            RPI_APP_PORT="${APP_PORT}" \
            ARCHIVE_PATH="${ARCHIVE}" \
            RELEASE_ID="${GITHUB_SHA::12}" \
            RPI_ENV_FILE_CONTENT="${RPI_ENV_FILE_CONTENT:-}" \
            "${BOOTSTRAP_DIR}/scripts/deploy-rpi.sh"
